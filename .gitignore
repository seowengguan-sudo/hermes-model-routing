# ── Credentials (never commit) ──
.env
GithubToken.txt
config.yaml
config.yaml.*
home/.git-credentials
auth.json
model_state.json
refresh_models.py

# ── Runtime SQLite state (never commit — race-condition risk #68474) ──
state.db
state.db-wal
state.db-shm
state.db-journal
cron/executions.db
cron/executions.db-shm
cron/executions.db-wal
cron/executions.db-journal
cron/.tick.lock
cron/catch_up_occurrences
cron/ticker_heartbeat
cron/ticker_last_success
cron/jobs.json.bak.*
*.db-shm
*.db-wal
*.db-journal

# ── Runtime logs (never commit) ──
logs/agent.log
logs/dashboard-auth.log
logs/errors.log
logs/gui.log
logs/gateway_start.log
logs/tui_gateway_crash.log
logs/gateway.log
logs/gateway-exit-diag.log
logs/gateway_faulthandler.log
logs/gateways/
logs/*.log

# ── Runtime databases ──
kanban.db
kanban.db-shm
kanban.db-wal
kanban.db-journal

# ── Runtime caches & lock files ──
.hermes_history
.boot_time
.tui-theme-boot.json
.lsp/
.lsp.lock
.processes.lock
gateway.lock
gateway.pid
gateway_state.json
gateway-starts.log
context_length_cache.yaml
channel_directory.json
models_dev_cache.json
provider_models_cache.json
ollama_cloud_models_cache.json
skills/.usage.json.lock
skills/.bundled_manifest.lock
sketches.lock
skills/.usage.json
skills/.bundled_manifest.lock
projects.db
projects.db-shm
projects.db-wal
projects.db-journal

# ── Python bytecode caches (never commit) ──
__pycache__/
*.pyc
*.pyo

# ── Large/Vendor directories (never commit) ──
.venv/
.venv-docreader/
home/.cache/
.cache/
.cache/

# ── Large binaries ──
*.zip
*.tar.gz
*.so
*.dll
*.dylib
*.bin

# BUT allow the OAKAI portable ZIPs
!workspace/Samples/doc_reader_windows_portable.zip
!workspace/Samples/poc_reader_windows_portable.zip

# ── Backup files ──
*.bak
*.bak-*
.env*

# ── Runtime & temp ──
/tmp/
/tmp/*/
*.tmp

# ── Screenshots (large, not needed in repo) ──
workspace/Samples/*.png
workspace/Samples/*.jpg
workspace/Samples/*.jpeg

# ── Document reader data (runtime, not source) ──
data/
state/

# Doc reader project runtime data (not source code)
projects/doc_reader/data/uploads/
projects/doc_reader/data/documents_safe/
projects/doc_reader/data/redaction_maps/*
!projects/doc_reader/data/redaction_maps/.gitkeep
projects/doc_reader/data/redaction_settings.json
